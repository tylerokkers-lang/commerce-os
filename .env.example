# =============================================================================
# Commerce OS environment
#
# Nothing here is required to run the application. With no variables set at all
# it starts in demo mode, which is fully browsable and cannot touch a real
# marketplace, supplier, accounting or email account.
#
# Copy to .env.local and fill in what you have. Each integration activates
# independently as soon as its own variables are present.
# =============================================================================

# Set to "live" only when Supabase is configured. Any other value, or an absent
# value, keeps the system in demo mode.
COMMERCE_OS_MODE=demo

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Database, auth and storage. Everything else depends on these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row level security. Server-side only. Never expose to the browser
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify (Milestone Shopify-Read-Only) -----------------------------------
# GraphQL Admin API + client-credentials grant — the current, documented
# flow for a server-side app acting on stores in your own Shopify
# organisation. Legacy static "custom app" tokens are no longer issuable
# by Shopify (removed from the admin UI 2026-01-01); there is no
# SHOPIFY_ADMIN_ACCESS_TOKEN to obtain any more.
#
# Setup: create an app in the Dev Dashboard (dev.shopify.com), in the SAME
# Shopify organisation as your store; select read_products, read_orders,
# read_inventory and read_fulfillments as the app version's access scopes
# (no write scope); install the app on your store; copy the Client ID and
# Client secret from the app's Settings page.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=

# --- Amazon Selling Partner API ---------------------------------------------
# A1F83G8C2ARO7P is the Amazon UK marketplace id.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_MARKETPLACE_ID=A1F83G8C2ARO7P
# Separate AWS IAM credentials for SP-API request signing (SigV4), distinct
# from the LWA application credentials above. SP-API sits behind AWS API
# Gateway, so both are required.
AMAZON_SP_AWS_ACCESS_KEY_ID=
AMAZON_SP_AWS_SECRET_ACCESS_KEY=

# --- eBay (Milestone 21) ------------------------------------------------------
# MANUAL_PURCHASE_MODE: this integration reads orders/listings and can push
# tracking back to eBay; it never purchases anything or moves money.
#
# EBAY_CLIENT_ID / EBAY_CLIENT_SECRET: from a PRODUCTION keyset at
# https://developer.ebay.com/my/keys (the "App ID (Client ID)" and
# "Cert ID (Client Secret)" of a Production, not Sandbox, keyset — this
# connector always targets api.ebay.com, never api.sandbox.ebay.com).
#
# EBAY_REFRESH_TOKEN: a long-lived (18-month) token obtained ONCE, outside
# this codebase, via eBay's user-consent authorization-code flow (there is
# no in-app OAuth UI here — this is a one-time manual step, the same as
# AMAZON_SP_REFRESH_TOKEN above): sign in as the seller account at
# developer.ebay.com/my/keys, use the "Get a User Token" / "Sign in to
# production" tool against your keyset's redirect URI (RuName), and the
# resulting authorization code is exchanged once for a refresh_token — set
# that value here, never the short-lived access_token it also returns.
#
# The refresh token must be consented with, at minimum:
#   https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
#   https://api.ebay.com/oauth/api_scope/sell.inventory.readonly
#   https://api.ebay.com/oauth/api_scope/sell.fulfillment (tracking push only)
# No payments/finances scope is required or requested.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# --- Resend -----------------------------------------------------------------
# Invoice and alert delivery. The from address must be on a domain verified
# in Resend.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=

# --- Xero -------------------------------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# --- Claude API -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Automation scheduler (Milestone 6; canonical entry point since Milestone 18) ---
# Shared secret an external scheduler (cron, a hosted worker, a serverless
# scheduled function) presents to POST /api/automation/maintenance,
# /api/automation/run and /api/monitoring/run as "Authorization: Bearer
# <value>". Required once Supabase is configured — every one of those
# routes refuses to run against a live database without it.
#
# /api/automation/maintenance is the one route to actually schedule: it runs
# execution recovery and advertising campaign monitoring together (never a
# live provider mutation — see HANDOVER.md §34, "Milestone 18").
# Recommended interval: every 15 minutes. Point any scheduler at that URL —
# nothing about it depends on Claude Code, ChatGPT, or any coding assistant
# being open. If deploying to Vercel, this repo's vercel.json already
# configures Vercel Cron to call it on that interval; set CRON_SECRET (a
# separate env var Vercel's own cron infrastructure reads) to the exact same
# value as AUTOMATION_CRON_SECRET so Vercel's automatic Authorization header
# matches what these routes check.
AUTOMATION_CRON_SECRET=

# --- Advertising connectors (Milestone 15; capability/verification model since Milestone 19) ---
# None of these are required — every advertising platform runs demo-only
# without them. Setting a platform's full set of variables makes
# isConfigured() true for that connector, which is NOT the same as
# "verified" or "safe to write to": see HANDOVER.md §35 ("Milestone 19")
# for the full IMPLEMENTED / CONFIGURED / READ VERIFIED / WRITE VERIFIED /
# LIVE distinction, and /advertising's per-capability breakdown for the
# real, current status of each one.
#
# Amazon Ads: IMPLEMENTED, NOT LIVE-VERIFIED. No account is registered
# against this codebase — do not set these against a real, live-spending
# Amazon Ads account without reading src/lib/advertising/connectors/amazonAds.ts's
# own "UNVERIFIED API SURFACE" comment first.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=

# Meta Ads / Google Ads / TikTok Ads: STUB. No integration is written for
# any of these three yet — setting these variables has no effect; each
# connector reports itself unavailable regardless (Milestone 19, Phase 16).
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# --- Advertising write-capability verification (Milestone 19, Phase 8) ------
# The one flag standing between advertising/writeVerification.ts's
# runWriteVerification and actually calling a live pauseCampaign/setBudget
# write. Unset (or anything other than the literal string "true") disables
# it — the default, and the only state this repository ships in.
# runWriteVerification is never wired to any HTTP route or scheduled job
# regardless of this flag; setting it only matters if you are calling that
# function directly, deliberately, against a real, explicitly-designated
# test/sandbox campaign you own. Never set this against a real advertiser
# account's live campaigns.
ADVERTISING_WRITE_VERIFICATION_ENABLED=
